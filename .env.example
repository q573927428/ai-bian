# Binance API 配置
# 请前往 https://www.binance.com/zh-CN/my/settings/api-management 创建API密钥
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_api_secret_here

# AI 配置 (可选)
# 支持多个AI提供商：deepseek, doubao, qwen, openai
# 默认提供商
AI_PROVIDER=deepseek

# DeepSeek 配置
# 请前往 https://platform.deepseek.com/api_keys 获取API密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 豆包 (Doubao) 配置
# 请前往 https://console.volcengine.com/ark 获取API密钥
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-pro

# 豆包 Agent Plan 配置
DOUBAO_AGENT_API_KEY=your_doubao_agent_api_key_here
DOUBAO_AGENT_API_URL=https://ark.cn-beijing.volces.com/api/plan/v3
DOUBAO_AGENT_MODEL=doubao-seed-2.1-lite

# 阿里千问 (Qwen) 配置
# 请前往 https://dashscope.console.aliyun.com/apiKey 获取API密钥
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI 兼容配置
# 适用于任何OpenAI兼容的API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 管理员账号密码：登录后 24 小时内免重复输入，刷新页面也保留
# 页面、行情和首页概况公开；策略修改、删除、交易等 API 由后端验证 Cookie
# 任一未配置时敏感 API 返回 503，普通浏览仍可用；密码建议使用至少 24 位随机字符
CONFIG_EDIT_USERNAME=admin
CONFIG_EDIT_PASSWORD=

# 生产必填：浏览器实际访问的网站来源（协议 + 域名 + 可选端口，不带路径）
# 例：https://trade.example.com；用于拒绝跨站敏感请求，反代后也填写浏览器地址
# 生产 Cookie 仅经 HTTPS 发送；本地开发可留空，使用当前开发服务器来源
# 开发模式使用 localhost / 127.0.0.1 / [::1] 时按本机同源校验，可保留线上来源配置
OPERATION_AUTH_ORIGIN=
# BASIC_AUTH_USERNAME / BASIC_AUTH_PASSWORD 已停用，不再拦截整站访问
# 生产进程必须加载运行时环境变量；修改账号或密码后重启会使所有旧登录凭证失效

# 加密密钥 (可选)
# 用于加密存储策略中配置的 API Key，防止明文泄露
# 长度至少16位，建议使用随机字符串
# 如果不设置，系统会使用内置默认密钥（安全性较低，建议设置）
ENCRYPTION_KEY=

# K线数据存储目录配置 (可选)
# 默认使用项目根目录下的 data/kline-simple 目录
# 如果服务器权限问题，可以设置此变量指定可写目录
# 例如: KLINE_DATA_DIR=/var/data/kline-simple
# KLINE_DATA_DIR=

# K线数据库固定使用 Node.js 内置 node:sqlite
# 需要 Node.js 22.13+，推荐 Node.js 22.22+ 或 24 LTS
